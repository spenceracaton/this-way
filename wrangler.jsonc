{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "this-way",
  "account_id": "60b5930216f6049236d2634115cbe0ce",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "preview_urls": false,
  "main": "./server/index.mjs",
  "d1_databases": [
    { "binding": "DB", "database_name": "this-way-listings", "migrations_dir": "./migrations" }
  ],
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "this-way-photos" }
  ],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
